# Copy to .env to override the defaults used by docker-compose.yml and scripts/.
# Local development values only. Never put real credentials here.
DB_NAME=hotel
DB_USER=hotel_user
DB_PASSWORD=hotel_local_only
DB_PORT=5432

# Number of bookings generated on first start (assessment minimum: 100).
SEED_BOOKING_COUNT=50000

# Days of local backups to keep in backups/.
BACKUP_RETENTION_DAYS=7
